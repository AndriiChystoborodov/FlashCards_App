NODE_ENV=development
SLACK_MODE=socket
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TEST_USER_ID=
TENANT_TIMEZONE=Europe/Zurich
SEND_HOUR=9
TICK_MINUTES=15
REMOVED_RETENTION_DAYS=14
STUDENT_ROUTES_ENABLED=false
# REST server (npm run dev). Loopback by default; the student routes refuse any other host (decision 0028).
HOST=127.0.0.1
PORT=3000
# Local Docker Postgres from docker-compose.yml (npm run db:up), decisions 0023 and 0024.
# DATABASE_URL is the dev database (npm run db:reset creates it); tests use TEST_DATABASE_URL.
DATABASE_URL=postgres://retain:retain@localhost:5433/retain_dev
TEST_DATABASE_URL=postgres://retain:retain@localhost:5433/retain_test
