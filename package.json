{
  "name": "retain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "spike": "tsx src/slack/spike.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "docker compose up -d --wait db",
    "db:reset": "tsx src/db/reset.ts",
    "scenario": "tsx scripts/scenario.ts"
  },
  "dependencies": {
    "@slack/bolt": "5.1.0",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "ts-fsrs": "5.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
